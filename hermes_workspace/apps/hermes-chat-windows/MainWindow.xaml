<Window x:Class="HermesChat.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:HermesChat"
        Title="HermesWorkspace"
                Height="1000" Width="1480" MinHeight="900" MinWidth="1200"
                        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Разделы -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,8">
            <DockPanel><TextBlock Text="HERMES  /  WORKSPACE" FontWeight="Bold" FontSize="16" VerticalAlignment="Center" Margin="0,0,24,0"/><StackPanel Orientation="Horizontal"> <Button x:Name="TabWorkspace" Content="Workspace" Tag="workspace" Style="{StaticResource TabBtn}" Click="OnTabClick"/>
                <Button x:Name="TabChats" Content="Проекты" Tag="chats" Style="{StaticResource TabBtn}"
                        Click="OnTabClick" HorizontalAlignment="Left"/>
                <Button x:Name="TabProfiles" Content="Профили" Tag="profiles" Style="{StaticResource TabBtn}"
                        Click="OnTabClick" HorizontalAlignment="Left"/>
                <Button x:Name="TabGateways" Content="Шлюзы" Tag="gateways" Style="{StaticResource TabBtn}"
                        Click="OnTabClick" HorizontalAlignment="Left"/>
                <Button x:Name="TabSessions" Content="Сессии" Tag="sessions" Style="{StaticResource TabBtn}"
                        Click="OnTabClick" HorizontalAlignment="Left"/>
            </StackPanel></DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <local:WorkspaceView x:Name="Overview" Visibility="Collapsed"/>
            <Grid x:Name="HiddenRunners" Visibility="Collapsed"/>
            <local:ChatsTab x:Name="Chats" Visibility="Visible"/>
            <local:ProfilesTab x:Name="Profiles" Visibility="Collapsed"/>
            <local:GatewaysTab x:Name="Gateways" Visibility="Collapsed"/>
            <local:SessionsTab x:Name="Sessions" Visibility="Collapsed"/>
        </Grid>
        <Border x:Name="ApprovalToast" Grid.RowSpan="2" Panel.ZIndex="100" Visibility="Collapsed" Width="460" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,76,24,0" Background="{StaticResource PanelHi}" BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="14" Padding="20"><StackPanel><TextBlock Text="НУЖЕН АППРУВ" Foreground="{StaticResource Accent}" FontWeight="Bold"/><TextBlock x:Name="ApprovalText" TextWrapping="Wrap" Margin="0,10"/><StackPanel Orientation="Horizontal"><Button Content="Открыть и проверить" Click="OnOpenApprovals" Style="{StaticResource PrimaryBtn}"/><Button Content="Позже" Click="OnDismissToast" Style="{StaticResource Btn}" Margin="8,0,0,0"/></StackPanel></StackPanel></Border>
    </Grid>
</Window>