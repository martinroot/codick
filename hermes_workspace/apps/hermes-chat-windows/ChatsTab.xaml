<UserControl x:Class="HermesChat.ChatsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HermesChat">
    <UserControl.Resources>
            <DataTemplate x:Key="ThreadItemTemplate">
                <StackPanel Margin="0,1,0,1">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock Text="{Binding Place}" FontSize="11" Foreground="{StaticResource Dim}"
                               TextTrimming="CharacterEllipsis"/>
                </StackPanel>
            </DataTemplate>
            <Style x:Key="ThreadListStyle" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Foreground" Value="{StaticResource Fg}"/>
                <Setter Property="ItemTemplate" Value="{StaticResource ThreadItemTemplate}"/>
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            </Style>
            <local:HexBrushConverter x:Key="HexBrush"/>
            <Style x:Key="SectionHeaderStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="Foreground" Value="{StaticResource Accent}"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </UserControl.Resources>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Слева: профили — основные адресаты; свободные чаты сохранены в архиве.
                 У каждого шлюза ниже один закреплённый диалог/сессия. -->
            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <Grid Margin="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

<Grid Grid.Row="0"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><StackPanel>
                            <StackPanel Margin="0,2,0,0">
                                <TextBlock Text="ПРОЕКТЫ · ОРКЕСТРАТОРЫ" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4"/>
                                <ListBox x:Name="ProfileList" ScrollViewer.VerticalScrollBarVisibility="Disabled" Background="Transparent"
                                         BorderThickness="0" Foreground="{StaticResource Fg}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="OnProfilePicked">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                                            Background="{Binding Color, Converter={StaticResource HexBrush}}"/>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock FontSize="11" Foreground="{StaticResource Dim}" Margin="16,0,0,0"
                                                           TextTrimming="CharacterEllipsis" Text="{Binding QueueLine}"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="ProfileHint" FontSize="11" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,6,0,0" Visibility="Collapsed"
                                           Text="Профилей нет: снимок дерева не найден. Создай их во вкладке «Профили оркестраторов»."/>
                            </StackPanel>

<DockPanel Margin="0,4,0,8"><Button Content="‹" Click="OnProjectsPrev" Style="{StaticResource Btn}" Padding="8,2"/><Button Content="›" Click="OnProjectsNext" Style="{StaticResource Btn}" Padding="8,2"/><TextBlock x:Name="ProjectPageText" Foreground="{StaticResource Dim}" VerticalAlignment="Center" Margin="8,0"/></DockPanel>
</StackPanel><ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>                            <StackPanel Margin="0,14,0,0">
                                <TextBlock Text="ШЛЮЗЫ · СЕРВЕРЫ" Style="{StaticResource SectionHeaderStyle}" Margin="0,0,0,4"/>
                                <ListBox x:Name="GatewayList" MaxHeight="120" Background="Transparent"
                                         BorderThickness="0" Foreground="{StaticResource Fg}"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                         SelectionChanged="OnGatewayPicked">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,1,0,1">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="8" Height="8" CornerRadius="4" VerticalAlignment="Center"
                                                            Background="{Binding StatusBrush}"/>
                                                    <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="8,0,0,0"/>
                                                </StackPanel>
                                                <TextBlock Text="{Binding Url}" FontSize="11" Foreground="{StaticResource Dim}"
                                                           Margin="16,0,0,0" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock x:Name="GatewayHint" FontSize="11" Foreground="{StaticResource Dim}"
                                           TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Внешних шлюзов нет. Добавь HTTP-адрес во вкладке «Внешние шлюзы»."/>
                            </StackPanel>
<TextBlock Text="СВОБОДНЫЕ ПРОФИЛИ" Style="{StaticResource SectionHeaderStyle}" Margin="0,12,0,4"/>
<ListBox x:Name="FreeProfileList" MaxHeight="100" Style="{StaticResource ThreadListStyle}" ItemTemplate="{StaticResource NameOnly}" SelectionChanged="OnProfilePicked"/>
                            <Expander x:Name="ChatArchiveExpander" Margin="0,14,0,0" IsExpanded="False"
                                      Foreground="{StaticResource Fg}" Background="Transparent">
                                <Expander.Header>
                                    <TextBlock x:Name="ChatArchiveHeader" Text="АРХИВ СВОБОДНЫХ ЧАТОВ"
                                               Style="{StaticResource SectionHeaderStyle}"/>
                                </Expander.Header>
                                <ListBox x:Name="ChatList" Style="{StaticResource ThreadListStyle}"
                                         MaxHeight="260" SelectionChanged="OnThreadSelected"/>
                            </Expander>

</StackPanel></ScrollViewer></Grid>

                    <StackPanel Grid.Row="1" Margin="0,12,0,4">
                        <Button Content="+ Свободный чат" Style="{StaticResource Btn}" Click="OnNewThread" HorizontalAlignment="Stretch"/>
                        <Button Content="Настройки" Style="{StaticResource Btn}" Click="OnSettings" HorizontalAlignment="Stretch" Margin="0,8,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

        <!-- Справа: лента -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,10">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" x:Name="StopBtn" Content="Остановить" Style="{StaticResource Btn}"
                                Click="OnStop" Visibility="Collapsed" MinWidth="110"/>
                        <TextBlock x:Name="HeaderText" Text="Проект" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Margin="10,0,0,0"/>
                    </DockPanel>
                </Border>
                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,5">
                    <TextBlock x:Name="StatsText" FontSize="10.5" Foreground="{StaticResource Dim}"
                               TextWrapping="Wrap" MaxHeight="44"/>
                </Border>
                <Border x:Name="SteerBar" Background="#2A2418" BorderBrush="{StaticResource Warn}" BorderThickness="0,0,0,1" Padding="12,6" Visibility="Collapsed">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Отправить подсказку" Style="{StaticResource Btn}" Click="OnSteerSend" Margin="8,0,0,0"/>
                        <TextBlock DockPanel.Dock="Left" Text="Подсказать агенту на лету:" FontSize="12" Foreground="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <TextBox x:Name="SteerInput" BorderThickness="0" Background="Transparent" Padding="0" VerticalAlignment="Center"/>
                    </DockPanel>
                </Border>
            </StackPanel>

            <!-- Рабочее пространство адресата: табы ВЫШЕ чата, а не рядом с ним.
                 Чат — основа и вкладка по умолчанию; дерево и очередь показывают
                 состояние того же направления, поэтому разговор с агентом не
                 исчезает, когда ты смотришь на дерево. Поле ввода (Row 2) лежит
                 под табами и доступно во всех трёх. -->
            <TabControl x:Name="WorkspaceTabs" Grid.Row="1" Style="{StaticResource WsTabs}"
                        SelectionChanged="OnWorkspaceTab">

                <TabItem x:Name="TabChat" Header="Чат-оркестратор">
                    <Grid>
                        <ScrollViewer x:Name="FeedScroll" VerticalScrollBarVisibility="Auto" Padding="16">
                            <StackPanel x:Name="Feed" Margin="0,8"/>
                        </ScrollViewer>
                        <Border x:Name="DropHint" Background="#1E2A38" BorderBrush="{StaticResource Accent}"
                                BorderThickness="2" CornerRadius="8" Padding="16" Margin="16,8,16,0" Visibility="Collapsed">
                            <TextBlock Text="Отпусти файл — он прикрепится к сообщению" HorizontalAlignment="Center" Foreground="{StaticResource Accent}"/>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem x:Name="TabTree" Header="Дерево">
                    <Grid Margin="16,10,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="TreeHint" FontSize="11.5" Foreground="{StaticResource Dim}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <TreeView x:Name="TreeView" Grid.Row="1" Background="Transparent" Foreground="{StaticResource Fg}"
                                  BorderThickness="0"/>
                    </Grid>
                </TabItem>

                <TabItem x:Name="TabQueue" Header="Задачи">
                    <Grid Margin="16,10,16,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <TextBlock x:Name="QueueHint" FontSize="11.5" Foreground="{StaticResource Dim}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="QueuePanel" Margin="0,0,8,0"/>
                        </ScrollViewer>
                    </Grid>
                </TabItem>
                <TabItem Header="Прогресс"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ProgressPanel" Margin="20"/></ScrollViewer></TabItem>
                <TabItem Header="Настройки"><StackPanel Margin="20">                        <StackPanel  Orientation="Horizontal" Margin="0,0,14,0">
                            <TextBlock Text="Модель" VerticalAlignment="Center" FontSize="12"
                                       Foreground="{StaticResource Dim}" Margin="0,0,6,0"/>
                            <ComboBox x:Name="ModelBox" Width="250" IsEditable="True" StaysOpenOnEdit="True"
                                      ItemTemplate="{StaticResource ModelItemTemplate}"
                                      SelectionChanged="OnModelChanged" LostFocus="OnModelTyped"
                                      ToolTip="Модель этого диалога. Свой идентификатор можно вписать руками."/>
                            <Button x:Name="ModelSaveBtn" Content="ОК" Style="{StaticResource Btn}" Margin="6,0,0,0"
                                    Click="OnModelTyped" ToolTip="Применить вписанную модель" Padding="8,3"/>
                        </StackPanel>
                        <ComboBox x:Name="ProfileBox"  Width="250" Margin="0,0,8,0"
                                  SelectionChanged="OnProfileChanged"
                                  ToolTip="Агент этого диалога. Пусто — универсальный."/>
<Expander Header="Диагностика сессии" Foreground="{StaticResource Dim}" Margin="0,12">                <Border Background="{StaticResource Bg}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,4">
                    <DockPanel LastChildFill="True">
                        <Button x:Name="CopyIdsBtn" DockPanel.Dock="Right" Content="⧉ ID" Style="{StaticResource Btn}"
                                Click="OnCopyIds" Padding="8,3" Margin="8,0,0,0" ToolTip="Скопировать идентификаторы этого чата и последнего сообщения"/>
                        <TextBlock x:Name="IdentityText" FontSize="10.5" Foreground="{StaticResource Dim}"
                                   TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                    </DockPanel>
                </Border>
</Expander><TextBlock Text="Оркестратор и исполнитель" FontSize="22"/><TextBlock Text="Выберите шлюз и два существующих чата. Оркестратор ставит TODO сообщением, ответ исполнителя будит его для проверки и следующего шага." TextWrapping="Wrap" Margin="0,12"/><ComboBox x:Name="ProjectGatewayBox" SelectionChanged="OnProjectGatewayChanged">
<ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate>
</ComboBox>
<TextBlock Text="Чат оркестратора (этот проект)" Margin="0,12,0,4"/>
<ComboBox x:Name="OrchestratorChatBox" ItemTemplate="{StaticResource ThreadTitleOnly}" SelectionChanged="OnChatBindingChanged"/>
<Button Content="Открыть чат оркестратора" Click="OnOpenBoundChat" Tag="orchestrator" Style="{StaticResource Btn}" Margin="0,4,0,0"/>
<TextBlock Text="Чат исполнителя (выбранный шлюз)" Margin="0,12,0,4"/>
<ComboBox x:Name="ExecutorChatBox" ItemTemplate="{StaticResource ThreadTitleOnly}" SelectionChanged="OnChatBindingChanged"/>
<Button Content="Открыть чат исполнителя" Click="OnOpenBoundChat" Tag="executor" Style="{StaticResource Btn}" Margin="0,4,0,0"/>
<TextBlock Text="START разрешает до 50 итераций. STOP отменяет текущую отправку и следующие шаги. Приложение должно оставаться открытым. Локеры: @lock:ресурс; блокеры: @blocked / @owner / @deferred." TextWrapping="Wrap" Foreground="{StaticResource Dim}" Margin="0,12,0,4"/>
<StackPanel Orientation="Horizontal" Margin="0,8,0,0"><Button x:Name="LoopButton" Content="START цикла" Style="{StaticResource PrimaryBtn}" Click="OnToggleLoop" MinWidth="150"/><TextBlock x:Name="LoopStateText" Text="Цикл: остановлен" VerticalAlignment="Center" Margin="10,0,0,0" FontSize="12" Foreground="{StaticResource Dim}"/></StackPanel><Button Content="Обновить дерево из JSON…" Click="OnImportTree" Style="{StaticResource Btn}" Margin="0,16,0,0"/><Button Content="Предложить следующий TODO" Click="OnProposeIteration" Style="{StaticResource PrimaryBtn}" Margin="0,16,0,0"/><Button Content="Настройки подключения и модели" Click="OnSettings" Style="{StaticResource Btn}" Margin="0,8,0,0"/></StackPanel></TabItem>
            </TabControl>

            <!-- Панель запросов шлюза: разрешения и вопросы модели живут ЗДЕСЬ, над
                 полем ввода, а не внутри ленты. В ленте блок уезжал наверх вместе
                 с длинным ответом — до кнопок было не дотянуться, и вопрос выглядел
                 как «молчащий» агент. Панель всегда на виду и показывает все
                 открытые запросы, даже если их несколько. -->
            <Border x:Name="RequestBar" Grid.Row="2" Background="{StaticResource Panel}"
                    BorderBrush="{StaticResource Warn}" BorderThickness="0,1,0,0"
                    Padding="16,10" Visibility="Collapsed" MaxHeight="260">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="RequestPanel"/>
                </ScrollViewer>
            </Border>

            <Border x:Name="Composer" Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,12">
                <Grid AllowDrop="True" DragOver="OnDragOver" Drop="OnDrop" Background="Transparent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <ItemsControl x:Name="AttachBar" Grid.Row="0" Margin="0,0,0,10" Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        CornerRadius="6" Padding="8,4" Margin="0,0,8,8">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="×" Width="20" Margin="6,0,0,0"
                                                Style="{StaticResource Btn}" Padding="0" Tag="{Binding}"
                                                Click="OnRemoveAttachment"/>
                                        <TextBlock Text="{Binding Name}" MaxWidth="220" TextTrimming="CharacterEllipsis"
                                                   VerticalAlignment="Center" ToolTip="{Binding Path}"/>
                                        <TextBlock Text="{Binding SizeText}" FontSize="11" Foreground="{StaticResource Dim}"
                                                   VerticalAlignment="Center" Margin="8,0,0,0"/>
                                    </DockPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBox x:Name="Input" Grid.Row="0" AcceptsReturn="True" TextWrapping="Wrap"
                             MinHeight="72" MaxHeight="220" VerticalScrollBarVisibility="Auto"
                             KeyDown="OnInputKey"/>
                    <DockPanel Grid.Row="2" Margin="0,10,0,0">
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button Content="Скриншот" Style="{StaticResource Btn}" Click="OnPasteImage" ToolTip="Ctrl+V — вставить скриншот из буфера"/>
                            <Button Content="Файл…" Style="{StaticResource Btn}" Click="OnPickFile" Margin="8,0,0,0"/>
                            <Button x:Name="SkillsBtn" Content="Навыки" Style="{StaticResource Btn}" Click="OnSkills" Margin="8,0,0,0"/>
                        </StackPanel>
                        <TextBlock x:Name="Hint" DockPanel.Dock="Right" VerticalAlignment="Center"
                                   Text="Enter — отправить. Ctrl+Enter — новая строка. Shift+Enter тоже переносит. Ctrl+V — скриншот."
                                   FontSize="11" Foreground="{StaticResource Dim}" Margin="10,0,0,0"/>
                        <Button x:Name="SendBtn" Content="Отправить" Style="{StaticResource PrimaryBtn}"
                                Click="OnSend" HorizontalAlignment="Right" MinWidth="130"/>
                    </DockPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>