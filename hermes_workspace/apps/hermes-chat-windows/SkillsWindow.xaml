<Window x:Class="HermesChat.SkillsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Навыки диалога" Height="560" Width="760"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Прикреплённый навык агент применяет в этом диалоге как обязательный к учёту."
                   FontSize="12" Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,12"/>

        <ListBox x:Name="List" Grid.Row="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                 BorderThickness="1" Foreground="{StaticResource Fg}" ItemTemplate="{StaticResource NameOnly}"/>

        <TextBlock x:Name="Description" Grid.Row="2" Margin="0,10,0,0" FontSize="12"
                   Foreground="{StaticResource Dim}" TextWrapping="Wrap" Height="48"/>

        <StackPanel Grid.Row="3" Orientation="Horizontal">
            <Button x:Name="AttachBtn" Content="Прикрепить" Style="{StaticResource Btn}" Click="OnAttach" MinWidth="130"/>
            <Button Content="Убрать" Style="{StaticResource Btn}" Click="OnDetach" Margin="8,0,0,0" MinWidth="110"/>
            <TextBlock x:Name="Chosen" FontSize="12" Foreground="{StaticResource Accent}"
                       VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis"/>
        </StackPanel>

        <Button Grid.Row="4" Content="Готово" Style="{StaticResource PrimaryBtn}" Click="OnOk"
                HorizontalAlignment="Right" Margin="0,16,0,0" MinWidth="130"/>
    </Grid>
</Window>