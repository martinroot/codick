<UserControl x:Class="HermesChat.AgentStudio" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
<Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<Border Padding="20,16" Background="{StaticResource Panel}" CornerRadius="10" Margin="0,0,0,12"><StackPanel><TextBlock x:Name="StudioTitle" Text="Мастерская агента" FontSize="24" FontWeight="SemiBold"/><TextBlock x:Name="StudioSummary" Text="Выберите профиль слева" Foreground="{StaticResource Dim}" Margin="0,8,0,0"/></StackPanel></Border>
<TabControl x:Name="StudioTabs" Grid.Row="1" Style="{StaticResource WsTabs}">
<TabItem Header="Скиллы"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel><Button Content="+ Новый скилл" Click="OnNewSkill" Style="{StaticResource PrimaryBtn}" DockPanel.Dock="Right"/><Button Content="Скиллы Hermes" Click="OnScanHermes" Style="{StaticResource Btn}" DockPanel.Dock="Right" Margin="0,0,8,0"/><Button Content="Импорт SKILL.md" Click="OnImportSkill" Style="{StaticResource Btn}" DockPanel.Dock="Right" Margin="0,0,8,0"/><TextBox x:Name="SkillSearch" TextChanged="OnSearch" MinWidth="180" ToolTip="Поиск по имени и описанию" Margin="0,0,16,0"/></DockPanel>
<TextBlock Grid.Row="1" Text="Инструкции и повторяемые пайплайны. Подключённые версии используются в следующем сообщении агента." Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,16"/>
<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><WrapPanel x:Name="SkillTiles"/></ScrollViewer></Grid></TabItem>
<TabItem Header="Инструменты"><Grid Margin="16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
<DockPanel><Button Content="+ Свой инструмент" Click="OnNewTool" Style="{StaticResource PrimaryBtn}" DockPanel.Dock="Right"/><Button Content="Проверить шлюз" Click="OnRefreshToolsets" Style="{StaticResource Btn}" DockPanel.Dock="Right" Margin="0,0,8,0"/><TextBox x:Name="ToolSearch" TextChanged="OnSearch" ToolTip="Поиск инструментов" Margin="0,0,16,0"/></DockPanel>
<TextBlock x:Name="ToolStatus" Grid.Row="1" Text="Собственные скрипты + реальные тулсеты выбранного шлюза. Подключение тулсета задаёт предпочтение; права определяет шлюз." Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,16"/>
<ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto"><StackPanel><WrapPanel x:Name="ToolTiles"/><TextBlock Text="На шлюзе" FontSize="18" Margin="0,16"/><WrapPanel x:Name="NativeTiles"/></StackPanel></ScrollViewer></Grid></TabItem>
<TabItem Header="Обучение"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><TextBlock Text="Проверить → исправить → сохранить" FontSize="22"/><TextBlock Text="Опишите задачу и критерии. Новый тест открывает отдельный чат профиля. После выполнения вернитесь сюда, сохраните результат и подтвердите проверку." Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,12"/>
<TextBlock Text="Тестовая задача"/><TextBox x:Name="TestPrompt" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="100" MaxHeight="180" VerticalScrollBarVisibility="Auto" Margin="0,6,0,12"/>
<TextBlock Text="Что должно получиться / как проверить"/><TextBox x:Name="TestExpected" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="65" Margin="0,6,0,12"/>
<WrapPanel><Button Content="Новый тестовый чат →" Click="OnStartTest" Style="{StaticResource PrimaryBtn}"/><Button Content="Сохранить последний ответ" Click="OnCaptureResult" Style="{StaticResource Btn}" Margin="8,0,0,0"/><Button Content="Ответ → скилл" Click="OnAnswerToSkill" Style="{StaticResource Btn}" Margin="8,0,0,0"/></WrapPanel>
<TextBlock Text="Проверки этого профиля" FontSize="18" Margin="0,24,0,12"/><StackPanel x:Name="TestHistory"/></StackPanel></ScrollViewer></TabItem>
<TabItem Header="Пакет и env"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="20"><TextBlock Text="Переносимый агент" FontSize="22"/><TextBlock Text="Экспорт: профиль, выбранные версии скиллов, код, вспомогательные файлы и тестовые сценарии. Память удалённых сессий в пакет не входит." Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,12"/>
<CheckBox x:Name="ExportSecrets" Content="Включить реальные значения .env в архив" Foreground="{StaticResource Fg}" Margin="0,8"/><CheckBox x:Name="ImportSecrets" Content="При импорте перенести .env из пакета" Foreground="{StaticResource Fg}" Margin="0,8"/><WrapPanel><Button Content="Скачать пакет агента…" Click="OnExport" Style="{StaticResource PrimaryBtn}"/><Button Content="Импортировать пакет…" Click="OnImportBundle" Style="{StaticResource Btn}" Margin="8,0,0,0"/></WrapPanel>
<TextBlock Text="Окружение профиля" FontSize="18" Margin="0,28,0,8"/><TextBlock Text="Значения сохраняются локально в .env и не отправляются модели. Для удалённого шлюза установите пакет и окружение на его сервере." Foreground="{StaticResource Dim}" TextWrapping="Wrap" Margin="0,0,0,12"/>
<TextBlock Text="Имя переменной (например SERVICE_API_KEY)"/><TextBox x:Name="EnvKey" Margin="0,6,0,12"/><TextBlock Text="Значение"/><PasswordBox x:Name="EnvValue" Background="{StaticResource Panel}" Foreground="{StaticResource Fg}" Padding="8" Margin="0,6,0,12"/><Button Content="Сохранить в .env" Click="OnSaveEnv" Style="{StaticResource Btn}" HorizontalAlignment="Left"/>
<StackPanel x:Name="EnvRows" Margin="0,16,0,0"/><TextBlock x:Name="PackageStatus" Foreground="{StaticResource Accent}" TextWrapping="Wrap" Margin="0,16"/></StackPanel></ScrollViewer></TabItem>
</TabControl></Grid></UserControl>
