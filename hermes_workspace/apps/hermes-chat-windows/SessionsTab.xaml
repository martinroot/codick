<UserControl x:Class="HermesChat.SessionsTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:HermesChat">
    <!-- Разговоры шлюза. Настоящая история лежит в api_server, а не в
         state.json: без этого списка приложение видело бы только свои
         переписки и не смогло бы подхватить консольный диалог. -->
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="440"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,14,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                <TextBlock Text="Разговоры шлюза" FontSize="13"/>
                <TextBlock Text="Шлюз" FontSize="12" Foreground="{StaticResource Dim}" Margin="0,8,0,0"/>
                <ComboBox x:Name="GatewayBox" Margin="0,4,0,0" SelectionChanged="OnGatewayChanged"
                          ItemTemplate="{StaticResource NameOnly}"
                          ToolTip="Какая машина. У каждой свой адрес, свой токен и свои сессии."/>
                <TextBlock x:Name="NoteText" FontSize="11" Foreground="{StaticResource Dim}"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Text="Сессии живут в api_server. Подхват сессии — это «переехать в шлюз»: история подтягивается, а отправка продолжает её."/>
            </StackPanel>

            <ListBox x:Name="SessionList" Grid.Row="1" Background="{StaticResource Panel}"
                     BorderBrush="{StaticResource Line}" BorderThickness="1"
                     Foreground="{StaticResource Fg}" SelectionChanged="OnSelect">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,4">
                            <StackPanel Orientation="Horizontal">
                                <Border Background="{StaticResource PanelHi}" CornerRadius="3" Padding="5,1"
                                    VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Badge}" FontSize="10" Foreground="{StaticResource Accent}"/>
                                </Border>
                                <TextBlock Text="{Binding Title}" FontSize="13" Margin="8,0,0,0"
                                    TextTrimming="CharacterEllipsis" MaxWidth="300"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                    <TextBlock FontSize="11" Foreground="{StaticResource Dim}"
                                        Text="{Binding MessageCount, StringFormat='{}{0} сообщений'}"/>
                                        <TextBlock FontSize="11" Foreground="{StaticResource Dim}" Margin="10,0,0,0"
                                            Text="{Binding ToolCallCount, StringFormat='инструментов: {0}'}"/>
                                            <TextBlock FontSize="11" Foreground="{StaticResource Dim}" Margin="10,0,0,0"
                                                Text="{Binding StartedText}"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                <TextBlock Text="{Binding ActiveText}" FontSize="10" Foreground="{StaticResource Accent}"/>
                                                <TextBlock Text="{Binding Id}" FontSize="10" Foreground="{StaticResource Dim}"
                                                    Margin="10,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="330"/>
                                                </StackPanel>
                                            </StackPanel>
                                                               </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,10,0,0">
                <Button Content="Обновить" Style="{StaticResource Btn}" Click="OnReload" MinWidth="110"/>
                <Button x:Name="OpenBtn" Content="Переехать в этот разговор" Style="{StaticResource PrimaryBtn}"
                        Click="OnOpen" Margin="8,0,0,0" MinWidth="230"/>
            </StackPanel>
        </Grid>

        <!-- Справа: что лежит в выбранной сессии, до переезда -->
        <Border Grid.Column="1" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                BorderThickness="1" CornerRadius="6" Padding="14">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock x:Name="DetailTitle" Text="Сессия не выбрана" FontSize="14" TextWrapping="Wrap"/>
                    <TextBlock x:Name="DetailMeta" FontSize="11" Foreground="{StaticResource Dim}"
                               TextWrapping="Wrap" Margin="0,6,0,12"/>
                    <TextBlock x:Name="DetailText" FontSize="12" TextWrapping="Wrap"
                               Foreground="{StaticResource Fg}" MaxHeight="600"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>