<Window x:Class="PulsePilot.TextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PulsePilot" Height="200" Width="520" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBlock x:Name="Label" Grid.Row="0" FontSize="13" Foreground="{StaticResource FgDim}" Margin="0,0,0,8"/>
        <TextBox x:Name="Box" Grid.Row="1" FontSize="15" Padding="10,8" VerticalContentAlignment="Top"
                 AcceptsReturn="False" TextChanged="OnChanged"/>
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Отмена" Click="Cancel" Margin="0,0,10,0" Padding="16,8"/>
            <Button Content="ОК" Click="Ok" Style="{StaticResource PrimaryBtn}" Padding="22,8" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
