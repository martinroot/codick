<Window x:Class="PulsePilot.BlockReasonWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Почему стоит запуск" Width="620" Height="520" Background="{StaticResource Bg}" WindowStartupLocation="CenterOwner" ResizeMode="NoResize">
  <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel>
    <TextBlock x:Name="TitleText" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/>
    <TextBlock x:Name="LiveText" Foreground="{StaticResource FgDim}" TextWrapping="Wrap" Margin="0,10,0,0"/>
    <TextBlock Text="Причина простоя" FontSize="15" FontWeight="SemiBold" Margin="0,18,0,8"/>
    <StackPanel x:Name="Reasons"/>
    <TextBlock Text="Факт одной строкой: что именно помешало" Foreground="{StaticResource FgDim}" FontSize="12" Margin="0,16,0,6"/>
    <TextBox x:Name="FactBox" AcceptsReturn="True" TextWrapping="Wrap" Height="90" VerticalScrollBarVisibility="Auto"/>
    <TextBlock x:Name="ErrorText" Foreground="{StaticResource Bad}" TextWrapping="Wrap" Margin="0,10,0,0"/>
   </StackPanel>
   <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
    <Button Content="Отмена" Click="Cancel" Margin="0,0,10,0" Padding="16,8"/>
    <Button Content="Записать причину" Click="Save" Style="{StaticResource PrimaryBtn}" Padding="20,8"/>
   </StackPanel>
  </Grid>
</Window>
