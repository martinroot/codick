# Сборочные артефакты .NET: воспроизводимы из исходников, в репозитории им не место.
bin/
obj/
dist/
*.pdb
*.exe
*.dll
# tree-snapshot.json НЕ исключаем: csproj копирует его при сборке,
# и без него проект не компилируется.
# Временные проекты WPF: WPF создаёт их при прерванной сборке и не убирает.
*_wpftmp.csproj

# Ярлыки и состояние конкретной машины в Windows/ — не исходники.
*.lnk
Windows/tree-snapshot.json

# Виртуальное окружение Python
.venv/
__pycache__/
